  dependencyType  TaskDependencyType @default(BLOCKS) @map("dependency_type")
  createdAt       DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  task            Task               @relation("TaskDependencyOwner", fields: [taskId], references: [id], onDelete: Restrict)
  dependsOnTask   Task               @relation("TaskDependencyTarget", fields: [dependsOnTaskId], references: [id], onDelete: Restrict)

  @@unique([taskId, dependsOnTaskId, dependencyType])
  @@index([dependsOnTaskId])
  @@map("task_dependencies")
}

