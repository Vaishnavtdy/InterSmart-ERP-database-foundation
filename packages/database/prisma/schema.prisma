generator client {
  provider = "prisma-client"
  output   = "../generated/client"
}

datasource db {
  provider = "postgresql"
}

enum DepartmentCode {
  SALES
  ACCOUNTS
  PMO
  UI
  UX
  DEVELOPMENT
  QA
  HR
  MANAGEMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Department {
  id        String         @id @default(uuid()) @db.Uuid
  code      DepartmentCode @unique
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  users     User[]

  @@map("departments")
}

model User {
  id            String           @id @default(uuid()) @db.Uuid
  employeeCode  String           @unique @map("employee_code") @db.VarChar(32)
  email         String           @unique @db.VarChar(320)
  passwordHash  String           @map("password_hash") @db.VarChar(255)
  firstName     String           @map("first_name") @db.VarChar(100)
  lastName      String           @map("last_name") @db.VarChar(100)
  phone         String?          @db.VarChar(32)
  departmentId  String           @map("department_id") @db.Uuid
  managerId     String?          @map("manager_id") @db.Uuid
  status        UserStatus       @default(ACTIVE)
  joiningDate   DateTime         @map("joining_date") @db.Timestamptz(6)
  lastLoginAt   DateTime?        @map("last_login_at") @db.Timestamptz(6)
  createdAt     DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt     DateTime         @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt     DateTime?        @map("deleted_at") @db.Timestamptz(6)
  department    Department       @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  manager       User?            @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports User[]           @relation("UserManager")
  profile       EmployeeProfile?

  @@index([departmentId, status])
  @@index([managerId])
  @@index([joiningDate])
  @@index([status, deletedAt])
  @@map("users")
}

model EmployeeProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  jobTitle     String?  @map("job_title") @db.VarChar(120)
  workLocation String?  @map("work_location") @db.VarChar(120)
  bio          String?  @db.VarChar(1000)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}
