model Bug {
  id               String                  @id @default(uuid()) @db.Uuid
  projectId        String                  @map("project_id") @db.Uuid
  projectQaId      String?                 @map("project_qa_id") @db.Uuid
  bugCode          String                  @unique @map("bug_code") @db.VarChar(64)
  title            String                  @db.VarChar(255)
  description      String                  @db.Text
  stepsToReproduce String?                 @map("steps_to_reproduce") @db.Text
  expectedResult   String?                 @map("expected_result") @db.Text
  actualResult     String?                 @map("actual_result") @db.Text
  severity         BugSeverity             @default(MAJOR)
  priority         ProjectPriority         @default(MEDIUM)
  status           BugStatus               @default(OPEN)
  source           BugSource               @default(MANUAL_TESTING)
  environmentId    String?                 @map("environment_id") @db.Uuid
  buildVersion     String?                 @map("build_version") @db.VarChar(100)
  reportedById     String                  @map("reported_by_id") @db.Uuid
  assignedToId     String?                 @map("assigned_to_id") @db.Uuid
  verifiedById     String?                 @map("verified_by_id") @db.Uuid
  resolvedAt       DateTime?               @map("resolved_at") @db.Timestamptz(6)
  verifiedAt       DateTime?               @map("verified_at") @db.Timestamptz(6)
  closedAt         DateTime?               @map("closed_at") @db.Timestamptz(6)
  createdAt        DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?               @map("deleted_at") @db.Timestamptz(6)
  project          Project                 @relation(fields: [projectId], references: [id], onDelete: Restrict)
  projectQa        ProjectQa?              @relation(fields: [projectId, projectQaId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  environment      DevelopmentEnvironment? @relation(fields: [environmentId], references: [id], onDelete: Restrict)
  reportedBy       User                    @relation("BugReporter", fields: [reportedById], references: [id], onDelete: Restrict)
  assignedTo       User?                   @relation("BugAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  verifiedBy       User?                   @relation("BugVerifier", fields: [verifiedById], references: [id], onDelete: Restrict)
  comments         BugComment[]
  statusHistory    BugStatusHistory[]
  taskLinks        BugTaskLink[]
  attachments      BugAttachment[]
  executionLinks   QaExecutionBug[]

  @@index([projectId, deletedAt])
  @@index([projectQaId])
  @@index([status, deletedAt])
  @@index([severity])
  @@index([priority])
  @@index([assignedToId])
  @@index([reportedById])
  @@index([verifiedById])
  @@index([environmentId])
  @@index([createdAt])
  @@map("bugs")
}

