generator client {
  provider            = "prisma-client"
  output              = "../generated/client"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum DepartmentCode {
  SALES
  ACCOUNTS
  PMO
  UI
  UX
  DEVELOPMENT
  QA
  HR
  MANAGEMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Department {
  id                String             @id @default(uuid()) @db.Uuid
  code              DepartmentCode     @unique
  createdAt         DateTime           @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime           @updatedAt @map("updated_at") @db.Timestamptz(6)
  users             User[]
  projectTeams      ProjectTeam[]
  budgetAllocations BudgetAllocation[]

  @@map("departments")
}

model User {
  id                      String            @id @default(uuid()) @db.Uuid
  employeeCode            String            @unique @map("employee_code") @db.VarChar(32)
  email                   String            @unique @db.VarChar(320)
  passwordHash            String            @map("password_hash") @db.VarChar(255)
  firstName               String            @map("first_name") @db.VarChar(100)
  lastName                String            @map("last_name") @db.VarChar(100)
  phone                   String?           @db.VarChar(32)
  departmentId            String            @map("department_id") @db.Uuid
  managerId               String?           @map("manager_id") @db.Uuid
  status                  UserStatus        @default(ACTIVE)
  joiningDate             DateTime          @map("joining_date") @db.Timestamptz(6)
  lastLoginAt             DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?         @map("deleted_at") @db.Timestamptz(6)
  department              Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  manager                 User?             @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports           User[]            @relation("UserManager")
  profile                 EmployeeProfile?
  assignedCustomers       Customer[]
  assignedLeads           Lead[]
  leadActivities          LeadActivity[]
  createdProposals        Proposal[]
  createdProposalVersions ProposalVersion[]

  salesProjects          Project[]              @relation("ProjectSalesperson")
  managedProjects        Project[]              @relation("ProjectManager")
  coordinatedProjects    Project[]              @relation("ProjectCoordinator")
  projectTeams           ProjectTeam[]
  projectStatusChanges   ProjectStatusHistory[]
  projectComments        ProjectComment[]
  assignedProjectActions ProjectAction[]        @relation("ProjectActionAssignee")
  createdProjectActions  ProjectAction[]        @relation("ProjectActionCreator")

  createdProjectScopes        ProjectScope[]                @relation("ScopeCreator")
  approvedProjectScopes       ProjectScope[]                @relation("ScopeApprover")
  createdBusinessAnalyses     BusinessAnalysis[]            @relation("AnalysisCreator")
  updatedBusinessAnalyses     BusinessAnalysis[]            @relation("AnalysisUpdater")
  uploadedFiles               File[]
  uploadedProjectResources    ProjectResource[]
  createdProjectBudgets       ProjectBudget[]               @relation("BudgetCreator")
  updatedProjectBudgets       ProjectBudget[]               @relation("BudgetUpdater")
  targetedBudgetAllocations   BudgetAllocation[]            @relation("AllocationTargetUser")
  createdBudgetAllocations    BudgetAllocation[]            @relation("AllocationCreator")
  createdBudgetTransactions   BudgetTransaction[]
  requestedPayments           PaymentRequest[]              @relation("PaymentRequester")
  approvedPaymentRequests     PaymentRequest[]              @relation("PaymentApprover")
  rejectedPaymentRequests     PaymentRequest[]              @relation("PaymentRejector")
  recordedPayments            Payment[]
  paymentStatusChanges        PaymentStatusHistory[]
  paymentRequestStatusChanges PaymentRequestStatusHistory[]
  createdTasks                Task[]                        @relation("TaskCreator")
  assignedTasks               Task[]                        @relation("TaskAssignee")
  taskComments                TaskComment[]
  taskStatusChanges           TaskStatusHistory[]
  receivedTaskAssignments     TaskAssignment[]              @relation("TaskAssignmentAssignee")
  issuedTaskAssignments       TaskAssignment[]              @relation("TaskAssignmentAuthor")
  createdProjectUis           ProjectUi[]                   @relation("UiCreator")
  approvedProjectUis          ProjectUi[]                   @relation("UiApprover")
  createdUiPages              UiPage[]
  createdUiSections           UiSection[]
  uiDailyStatuses             UiDailyStatus[]
  createdUiDesignLinks        UiDesignLink[]
  createdProjectUxs           ProjectUx[]                   @relation("UxCreator")
  approvedProjectUxs          ProjectUx[]                   @relation("UxApprover")
  createdUxScreens            UxScreen[]
  createdUxFlows              UxFlow[]
  uxDailyStatuses             UxDailyStatus[]
  createdUxDesignLinks        UxDesignLink[]
  createdSprints              Sprint[]
  createdDevelopmentVersions  ProjectDevelopment[]          @relation("DevelopmentCreator")
  approvedDevelopmentVersions ProjectDevelopment[]          @relation("DevelopmentApprover")
  createdDevelopmentModules   DevelopmentModule[]
  createdRepositories         DevelopmentRepository[]
  performedDeployments        DevelopmentDeployment[]
  developmentDailyReports     DevelopmentDailyReport[]
  createdQaVersions           ProjectQa[]                   @relation("QaCreator")
  approvedQaVersions          ProjectQa[]                   @relation("QaApprover")
  createdQaTestCases          QaTestCase[]
  qaTestExecutions            QaTestExecution[]
  createdQaBuilds             QaBuild[]
  qaDailyReports              QaDailyReport[]
  reportedBugs                Bug[]                         @relation("BugReporter")
  assignedBugs                Bug[]                         @relation("BugAssignee")
  verifiedBugs                Bug[]                         @relation("BugVerifier")
  bugComments                 BugComment[]
  bugStatusChanges            BugStatusHistory[]
  createdBugAttachments       BugAttachment[]
  createdInfrastructure       ProjectInfrastructure[]       @relation("InfrastructureCreator")
  approvedInfrastructure      ProjectInfrastructure[]       @relation("InfrastructureApprover")
  createdServers              ProjectServer[]
  createdDomains              ProjectDomain[]
  createdGoLiveAttempts       ProjectGoLive[]               @relation("GoLiveCreator")
  approvedGoLiveAttempts      ProjectGoLive[]               @relation("GoLiveApprover")
  completedGoLiveAttempts     ProjectGoLive[]               @relation("GoLiveCompleter")
  assignedGoLiveItems         GoLiveChecklistItem[]         @relation("ChecklistAssignee")
  completedGoLiveItems        GoLiveChecklistItem[]         @relation("ChecklistCompleter")
  issuedHandovers             ProductionHandover[]          @relation("HandoverSender")
  receivedHandovers           ProductionHandover[]          @relation("HandoverReceiver")

  @@index([departmentId, status])
  @@index([managerId])
  @@index([joiningDate])
  @@index([status, deletedAt])
  @@map("users")
}

model EmployeeProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  jobTitle     String?  @map("job_title") @db.VarChar(120)
  workLocation String?  @map("work_location") @db.VarChar(120)
  bio          String?  @db.VarChar(1000)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  BLOCKED
}

enum CustomerContactStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id                    String            @id @default(uuid()) @db.Uuid
  customerCode          String            @unique @map("customer_code") @db.VarChar(32)
  companyName           String            @map("company_name") @db.VarChar(255)
  website               String?           @db.VarChar(2048)
  industry              String?           @db.VarChar(120)
  country               String?           @db.VarChar(100)
  state                 String?           @db.VarChar(100)
  city                  String?           @db.VarChar(100)
  address               String?           @db.Text
  source                String?           @db.VarChar(120)
  status                CustomerStatus    @default(PROSPECT)
  assignedSalespersonId String?           @map("assigned_salesperson_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?         @map("deleted_at") @db.Timestamptz(6)
  assignedSalesperson   User?             @relation(fields: [assignedSalespersonId], references: [id], onDelete: SetNull)
  contacts              CustomerContact[]
  leads                 Lead[]
  proposals             Proposal[]

  projects        Project[]
  paymentRequests PaymentRequest[]
  payments        Payment[]

  @@index([companyName])
  @@index([status, deletedAt])
  @@index([assignedSalespersonId])
  @@map("customers")
}

model CustomerContact {
  id          String                @id @default(uuid()) @db.Uuid
  customerId  String                @map("customer_id") @db.Uuid
  firstName   String                @map("first_name") @db.VarChar(100)
  lastName    String?               @map("last_name") @db.VarChar(100)
  email       String?               @db.VarChar(320)
  phone       String?               @db.VarChar(32)
  designation String?               @db.VarChar(120)
  isPrimary   Boolean               @default(false) @map("is_primary")
  status      CustomerContactStatus @default(ACTIVE)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // One-primary-contact uniqueness is enforced by a partial SQL index in the migration.
  @@index([customerId])
  @@index([email])
  @@index([phone])
  @@map("customer_contacts")
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  MEETING
  PROPOSAL
  READY_TO_CLOSE
  WON
  LOST
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  ADVERTISEMENT
  COLD_CALL
  EMAIL
  DIRECT
  EXISTING_CUSTOMER
  OTHER
}

enum LeadActivityType {
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
  PROPOSAL
  NOTE
  WHATSAPP
  OTHER
}

model Lead {
  id                String          @id @default(uuid()) @db.Uuid
  leadCode          String          @unique @map("lead_code") @db.VarChar(32)
  customerId        String?         @map("customer_id") @db.Uuid
  assignedToId      String          @map("assigned_to_id") @db.Uuid
  source            LeadSource
  contactName       String          @map("contact_name") @db.VarChar(200)
  email             String?         @db.VarChar(320)
  phone             String?         @db.VarChar(32)
  companyName       String?         @map("company_name") @db.VarChar(255)
  requirement       String?         @db.Text
  estimatedValue    Decimal?        @map("estimated_value") @db.Decimal(18, 2)
  expectedCloseDate DateTime?       @map("expected_close_date") @db.Timestamptz(6)
  status            LeadStatus      @default(NEW)
  temperature       LeadTemperature @default(COLD)
  notes             String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)
  customer          Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo        User            @relation(fields: [assignedToId], references: [id], onDelete: Restrict)
  activities        LeadActivity[]
  proposals         Proposal[]

  @@index([customerId])
  @@index([assignedToId, status, deletedAt])
  @@index([status, deletedAt])
  @@index([temperature, deletedAt])
  @@index([expectedCloseDate])
  @@index([createdAt])
  @@map("leads")
}

model LeadActivity {
  id             String           @id @default(uuid()) @db.Uuid
  leadId         String           @map("lead_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  activityType   LeadActivityType @map("activity_type")
  subject        String           @db.VarChar(255)
  description    String?          @db.Text
  scheduledAt    DateTime?        @map("scheduled_at") @db.Timestamptz(6)
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(6)
  nextFollowUpAt DateTime?        @map("next_follow_up_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([userId, nextFollowUpAt])
  @@index([activityType])
  @@index([scheduledAt])
  @@index([nextFollowUpAt])
  @@map("lead_activities")
}

enum ProposalStatus {
  DRAFT
  SENT
  UNDER_NEGOTIATION
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ProposalVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Proposal {
  id               String            @id @default(uuid()) @db.Uuid
  proposalCode     String            @unique @map("proposal_code") @db.VarChar(32)
  leadId           String?           @map("lead_id") @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  createdById      String            @map("created_by_id") @db.Uuid
  title            String            @db.VarChar(255)
  status           ProposalStatus    @default(DRAFT)
  currentVersionId String?           @map("current_version_id") @db.Uuid
  validUntil       DateTime?         @map("valid_until") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)
  lead             Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  versions         ProposalVersion[] @relation("ProposalVersions")
  currentVersion   ProposalVersion?  @relation("ProposalCurrentVersion", fields: [id, currentVersionId], references: [proposalId, id], onDelete: Restrict, onUpdate: NoAction)

  projects Project[]

  @@index([leadId])
  @@index([customerId])
  @@index([createdById])
  @@index([status, deletedAt])
  @@index([validUntil])
  @@map("proposals")
}

model ProposalVersion {
  id              String                @id @default(uuid()) @db.Uuid
  proposalId      String                @map("proposal_id") @db.Uuid
  versionNumber   Int                   @map("version_number")
  status          ProposalVersionStatus @default(DRAFT)
  subtotal        Decimal               @db.Decimal(18, 2)
  discountAmount  Decimal               @map("discount_amount") @db.Decimal(18, 2)
  taxAmount       Decimal               @map("tax_amount") @db.Decimal(18, 2)
  totalAmount     Decimal               @map("total_amount") @db.Decimal(18, 2)
  notes           String?               @db.Text
  validUntil      DateTime?             @map("valid_until") @db.Timestamptz(6)
  createdById     String                @map("created_by_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt          DateTime?             @map("sent_at") @db.Timestamptz(6)
  acceptedAt      DateTime?             @map("accepted_at") @db.Timestamptz(6)
  rejectedAt      DateTime?             @map("rejected_at") @db.Timestamptz(6)
  rejectionReason String?               @map("rejection_reason") @db.Text
  proposal        Proposal              @relation("ProposalVersions", fields: [proposalId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items           ProposalItem[]
  currentFor      Proposal[]            @relation("ProposalCurrentVersion")

  @@unique([proposalId, versionNumber])
  // Required target key for the same-proposal current-version foreign key.
  @@unique([proposalId, id])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("proposal_versions")
}

model ProposalItem {
  id                String          @id @default(uuid()) @db.Uuid
  proposalVersionId String          @map("proposal_version_id") @db.Uuid
  description       String          @db.Text
  quantity          Decimal         @default(1) @db.Decimal(18, 4)
  unitPrice         Decimal         @map("unit_price") @db.Decimal(18, 2)
  discountType      DiscountType?   @map("discount_type")
  discountValue     Decimal?        @map("discount_value") @db.Decimal(18, 2)
  amount            Decimal         @db.Decimal(18, 2)
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  proposalVersion   ProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)

  @@index([proposalVersionId, sortOrder])
  @@map("proposal_items")
}

enum ProjectStatus {
  PLANNED
  ONGOING
  ON_HOLD
  COMPLETED
  TERMINATED
}

enum ProjectStatusReason {
  PAYMENT_PENDING
  NO_CLIENT_RESPONSE
  OUT_OF_SCOPE
  CONTENT_PENDING
  IMAGE_PENDING
  PAYMENT_GATEWAY_PENDING
  SMS_PENDING
  SMTP_PENDING
  TOO_MANY_CORRECTIONS
  REPEATED_CORRECTIONS
  BUDGET_EXCEEDED
  DATE_EXCEEDED
  MEETING_PENDING
  APPROVAL_PENDING
  OTHER
}

enum ProjectPriority {
  LOW
  MEDIUM
  HIGH
  URGENT
}

enum ProjectQualityLevel {
  STANDARD
  PREMIUM
  HIGH
}

enum ProjectPlatform {
  WEB
  MOBILE
  CMS
  ECOMMERCE
  CUSTOM_WEB
}

enum ProjectRole {
  PROJECT_MANAGER
  PROJECT_COORDINATOR
  UI_TL
  UI_RESOURCE
  UX_TL
  UX_RESOURCE
  DEV_TL
  DEV_RESOURCE
  QA
  SALES
  ACCOUNTS
  SYSTEM_ADMIN
}

enum ProjectActionType {
  CLIENT_RESPONSE_REQUIRED
  PAYMENT_FOLLOW_UP
  CONTENT_REQUIRED
  APPROVAL_REQUIRED
  MEETING_REQUIRED
  INTERNAL_ACTION
  OTHER
}

enum ProjectActionStatus {
  PENDING
  IN_PROGRESS
  COMPLETED
  CANCELLED
}

model Project {
  id                     String                  @id @default(uuid()) @db.Uuid
  projectCode            String                  @unique @map("project_code") @db.VarChar(32)
  name                   String                  @db.VarChar(255)
  customerId             String                  @map("customer_id") @db.Uuid
  proposalId             String?                 @map("proposal_id") @db.Uuid
  salesPersonId          String                  @map("sales_person_id") @db.Uuid
  projectManagerId       String?                 @map("project_manager_id") @db.Uuid
  projectCoordinatorId   String?                 @map("project_coordinator_id") @db.Uuid
  categoryId             String                  @map("category_id") @db.Uuid
  qualityLevel           ProjectQualityLevel?    @map("quality_level")
  platform               ProjectPlatform?
  pageCount              Int?                    @map("page_count")
  priority               ProjectPriority         @default(MEDIUM)
  status                 ProjectStatus           @default(PLANNED)
  startDate              DateTime?               @map("start_date") @db.Timestamptz(6)
  plannedEndDate         DateTime?               @map("planned_end_date") @db.Timestamptz(6)
  actualEndDate          DateTime?               @map("actual_end_date") @db.Timestamptz(6)
  createdAt              DateTime                @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt              DateTime                @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt              DateTime?               @map("deleted_at") @db.Timestamptz(6)
  customer               Customer                @relation(fields: [customerId], references: [id], onDelete: Restrict)
  proposal               Proposal?               @relation(fields: [proposalId], references: [id], onDelete: Restrict)
  salesPerson            User                    @relation("ProjectSalesperson", fields: [salesPersonId], references: [id], onDelete: Restrict)
  projectManager         User?                   @relation("ProjectManager", fields: [projectManagerId], references: [id], onDelete: SetNull)
  projectCoordinator     User?                   @relation("ProjectCoordinator", fields: [projectCoordinatorId], references: [id], onDelete: SetNull)
  category               ProjectCategory         @relation(fields: [categoryId], references: [id], onDelete: Restrict)
  team                   ProjectTeam[]
  statusHistory          ProjectStatusHistory[]
  comments               ProjectComment[]
  actions                ProjectAction[]
  scopes                 ProjectScope[]
  businessAnalysis       BusinessAnalysis?
  files                  File[]
  resources              ProjectResource[]
  budget                 ProjectBudget?
  paymentRequests        PaymentRequest[]
  payments               Payment[]
  tasks                  Task[]
  uiSpecifications       ProjectUi[]
  uxSpecifications       ProjectUx[]
  sprints                Sprint[]
  developmentVersions    ProjectDevelopment[]
  qaVersions             ProjectQa[]
  bugs                   Bug[]
  infrastructureVersions ProjectInfrastructure[]
  goLiveAttempts         ProjectGoLive[]
  productionHandovers    ProductionHandover[]

  @@index([customerId])
  @@index([proposalId])
  @@index([salesPersonId])
  @@index([projectManagerId])
  @@index([projectCoordinatorId])
  @@index([categoryId])
  @@index([status, deletedAt])
  @@index([priority, deletedAt])
  @@index([plannedEndDate])
  @@index([createdAt])
  @@map("projects")
}

model ProjectCategory {
  id          String            @id @default(uuid()) @db.Uuid
  parentId    String?           @map("parent_id") @db.Uuid
  name        String            @db.VarChar(100)
  code        String            @unique @db.VarChar(64)
  description String?           @db.Text
  isActive    Boolean           @default(true) @map("is_active")
  createdAt   DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  parent      ProjectCategory?  @relation("ProjectCategoryHierarchy", fields: [parentId], references: [id], onDelete: Restrict)
  children    ProjectCategory[] @relation("ProjectCategoryHierarchy")
  projects    Project[]

  @@index([parentId, isActive])
  @@map("project_categories")
}

model ProjectTeam {
  id                   String      @id @default(uuid()) @db.Uuid
  projectId            String      @map("project_id") @db.Uuid
  userId               String      @map("user_id") @db.Uuid
  departmentId         String      @map("department_id") @db.Uuid
  projectRole          ProjectRole @map("project_role")
  allocationPercentage Decimal?    @map("allocation_percentage") @db.Decimal(5, 2)
  assignedAt           DateTime    @default(now()) @map("assigned_at") @db.Timestamptz(6)
  releasedAt           DateTime?   @map("released_at") @db.Timestamptz(6)
  project              Project     @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user                 User        @relation(fields: [userId], references: [id], onDelete: Restrict)
  department           Department  @relation(fields: [departmentId], references: [id], onDelete: Restrict)

  // Active-assignment uniqueness is maintained by a partial index in migration SQL.
  @@index([projectId, releasedAt])
  @@index([userId, releasedAt])
  @@index([departmentId])
  @@index([projectRole])
  @@map("project_teams")
}

model ProjectStatusHistory {
  id          String               @id @default(uuid()) @db.Uuid
  projectId   String               @map("project_id") @db.Uuid
  fromStatus  ProjectStatus?       @map("from_status")
  toStatus    ProjectStatus        @map("to_status")
  reason      ProjectStatusReason?
  changedById String               @map("changed_by_id") @db.Uuid
  createdAt   DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  project     Project              @relation(fields: [projectId], references: [id], onDelete: Restrict)
  changedBy   User                 @relation(fields: [changedById], references: [id], onDelete: Restrict)

  // Append-only history is enforced by a PostgreSQL trigger in migration SQL.
  @@index([projectId, createdAt])
  @@index([changedById])
  @@index([createdAt])
  @@map("project_status_histories")
}

model ProjectComment {
  id        String   @id @default(uuid()) @db.Uuid
  projectId String   @map("project_id") @db.Uuid
  userId    String   @map("user_id") @db.Uuid
  comment   String   @db.Text
  createdAt DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  user      User     @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([projectId, createdAt])
  @@index([userId])
  @@index([createdAt])
  @@map("project_comments")
}

model ProjectAction {
  id           String              @id @default(uuid()) @db.Uuid
  projectId    String              @map("project_id") @db.Uuid
  assignedToId String              @map("assigned_to_id") @db.Uuid
