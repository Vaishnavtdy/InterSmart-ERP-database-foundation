model BudgetAllocation {
  id              String               @id @default(uuid()) @db.Uuid
  projectBudgetId String               @map("project_budget_id") @db.Uuid
  departmentId    String?              @map("department_id") @db.Uuid
  userId          String?              @map("user_id") @db.Uuid
  allocationType  BudgetAllocationType @map("allocation_type")
  allocatedAmount Decimal              @map("allocated_amount") @db.Decimal(18, 2)
  description     String?              @db.Text
  createdById     String               @map("created_by_id") @db.Uuid
  createdAt       DateTime             @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt       DateTime             @updatedAt @map("updated_at") @db.Timestamptz(6)
  projectBudget   ProjectBudget        @relation(fields: [projectBudgetId], references: [id], onDelete: Restrict)
  department      Department?          @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  user            User?                @relation("AllocationTargetUser", fields: [userId], references: [id], onDelete: Restrict)
  createdBy       User                 @relation("AllocationCreator", fields: [createdById], references: [id], onDelete: Restrict)
  transactions    BudgetTransaction[]

  // Target key prevents transactions from referencing another budget's allocation.
  @@unique([projectBudgetId, id])
  @@index([projectBudgetId, allocationType])
  @@index([departmentId])
  @@index([userId])
  @@index([allocationType])
  @@index([createdById])
  @@index([createdAt])
  @@map("budget_allocations")
}

model BudgetTransaction {
  id              String                @id @default(uuid()) @db.Uuid
  projectBudgetId String                @map("project_budget_id") @db.Uuid
  allocationId    String?               @map("allocation_id") @db.Uuid
  transactionType BudgetTransactionType @map("transaction_type")
  amount          Decimal               @db.Decimal(18, 2)
  reference       String?               @db.VarChar(255)
  description     String?               @db.Text
  transactionDate DateTime              @default(now()) @map("transaction_date") @db.Timestamptz(6)
  createdById     String                @map("created_by_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  projectBudget   ProjectBudget         @relation(fields: [projectBudgetId], references: [id], onDelete: Restrict)
  allocation      BudgetAllocation?     @relation(fields: [projectBudgetId, allocationId], references: [projectBudgetId, id], onDelete: Restrict, onUpdate: NoAction)
  createdBy       User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)

  @@index([projectBudgetId, transactionDate])
  @@index([allocationId])
  @@index([transactionType])
  @@index([transactionDate])
  @@index([createdById])
  @@index([createdAt])
  @@map("budget_transactions")
}

