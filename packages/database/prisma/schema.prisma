model PaymentRequest {
  id                 String                        @id @default(uuid()) @db.Uuid
  paymentRequestCode String                        @unique @map("payment_request_code") @db.VarChar(32)
  projectId          String                        @map("project_id") @db.Uuid
  customerId         String                        @map("customer_id") @db.Uuid
  requestedById      String                        @map("requested_by_id") @db.Uuid
  amount             Decimal                       @db.Decimal(18, 2)
  currency           String                        @default("INR") @db.VarChar(3)
  paymentType        PaymentType                   @map("payment_type")
  description        String?                       @db.Text
  dueDate            DateTime?                     @map("due_date") @db.Timestamptz(6)
  status             PaymentRequestStatus          @default(DRAFT)
  requestedAt        DateTime                      @default(now()) @map("requested_at") @db.Timestamptz(6)
  approvedAt         DateTime?                     @map("approved_at") @db.Timestamptz(6)
  approvedById       String?                       @map("approved_by_id") @db.Uuid
  rejectedAt         DateTime?                     @map("rejected_at") @db.Timestamptz(6)
  rejectedById       String?                       @map("rejected_by_id") @db.Uuid
  rejectionReason    String?                       @map("rejection_reason") @db.Text
  createdAt          DateTime                      @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt          DateTime                      @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt          DateTime?                     @map("deleted_at") @db.Timestamptz(6)
  project            Project                       @relation(fields: [projectId], references: [id], onDelete: Restrict)
  customer           Customer                      @relation(fields: [customerId], references: [id], onDelete: Restrict)
  requestedBy        User                          @relation("PaymentRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  approvedBy         User?                         @relation("PaymentApprover", fields: [approvedById], references: [id], onDelete: Restrict)
  rejectedBy         User?                         @relation("PaymentRejector", fields: [rejectedById], references: [id], onDelete: Restrict)
  payments           Payment[]
  statusHistory      PaymentRequestStatusHistory[]

  @@index([projectId, status])
  @@index([customerId])
  @@index([requestedById])
  @@index([approvedById])
  @@index([rejectedById])
  @@index([status, deletedAt])
  @@index([paymentType])
  @@index([dueDate])
  @@index([createdAt])
  @@map("payment_requests")
}

model Payment {
  id                   String                 @id @default(uuid()) @db.Uuid
