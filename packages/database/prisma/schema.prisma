model Task {
  id                  String                   @id @default(uuid()) @db.Uuid
  projectId           String                   @map("project_id") @db.Uuid
  sprintId            String?                  @map("sprint_id") @db.Uuid
  parentTaskId        String?                  @map("parent_task_id") @db.Uuid
  taskCode            String                   @unique @map("task_code") @db.VarChar(32)
  title               String                   @db.VarChar(255)
  description         String?                  @db.Text
  taskType            TaskType                 @default(GENERAL) @map("task_type")
  workstream          TaskWorkstream           @default(OTHER)
  status              TaskStatus               @default(TODO)
  priority            ProjectPriority          @default(MEDIUM)
  createdById         String                   @map("created_by_id") @db.Uuid
  assignedToId        String?                  @map("assigned_to_id") @db.Uuid
  startDate           DateTime?                @map("start_date") @db.Timestamptz(6)
  dueDate             DateTime?                @map("due_date") @db.Timestamptz(6)
  completedAt         DateTime?                @map("completed_at") @db.Timestamptz(6)
  estimatedHours      Decimal?                 @map("estimated_hours") @db.Decimal(10, 2)
  actualHours         Decimal?                 @map("actual_hours") @db.Decimal(10, 2)
  sortOrder           Int                      @default(0) @map("sort_order")
  createdAt           DateTime                 @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt           DateTime                 @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt           DateTime?                @map("deleted_at") @db.Timestamptz(6)
  project             Project                  @relation(fields: [projectId], references: [id], onDelete: Restrict)
  sprint              Sprint?                  @relation(fields: [projectId, sprintId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  parentTask          Task?                    @relation("TaskHierarchy", fields: [projectId, parentTaskId], references: [projectId, id], onDelete: Restrict, onUpdate: NoAction)
  childTasks          Task[]                   @relation("TaskHierarchy")
  createdBy           User                     @relation("TaskCreator", fields: [createdById], references: [id], onDelete: Restrict)
  assignedTo          User?                    @relation("TaskAssignee", fields: [assignedToId], references: [id], onDelete: Restrict)
  dependencies        TaskDependency[]         @relation("TaskDependencyOwner")
  dependentTasks      TaskDependency[]         @relation("TaskDependencyTarget")
  comments            TaskComment[]
  statusHistory       TaskStatusHistory[]
  assignments         TaskAssignment[]
  uiLinks             UiTaskLink[]
  uxLinks             UxTaskLink[]
  developmentLinks    DevelopmentTaskLink[]
  qaLinks             QaTaskLink[]
  bugLinks            BugTaskLink[]
  infrastructureLinks InfrastructureTaskLink[]

  // Composite target key keeps children in their parent's project.
  @@unique([projectId, id])
  @@index([projectId, status])
  @@index([parentTaskId])
  @@index([sprintId])
  @@index([assignedToId, status])
  @@index([createdById])
  @@index([status, deletedAt])
  @@index([priority])
  @@index([workstream])
  @@index([taskType])
  @@index([dueDate])
  @@index([createdAt])
  @@map("tasks")
}

model TaskDependency {
  id              String             @id @default(uuid()) @db.Uuid
