generator client {
  provider            = "prisma-client"
  output              = "../generated/client"
  importFileExtension = "js"
}

datasource db {
  provider = "postgresql"
}

enum DepartmentCode {
  SALES
  ACCOUNTS
  PMO
  UI
  UX
  DEVELOPMENT
  QA
  HR
  MANAGEMENT
}

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

model Department {
  id        String         @id @default(uuid()) @db.Uuid
  code      DepartmentCode @unique
  createdAt DateTime       @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt DateTime       @updatedAt @map("updated_at") @db.Timestamptz(6)
  users     User[]

  @@map("departments")
}

model User {
  id                      String            @id @default(uuid()) @db.Uuid
  employeeCode            String            @unique @map("employee_code") @db.VarChar(32)
  email                   String            @unique @db.VarChar(320)
  passwordHash            String            @map("password_hash") @db.VarChar(255)
  firstName               String            @map("first_name") @db.VarChar(100)
  lastName                String            @map("last_name") @db.VarChar(100)
  phone                   String?           @db.VarChar(32)
  departmentId            String            @map("department_id") @db.Uuid
  managerId               String?           @map("manager_id") @db.Uuid
  status                  UserStatus        @default(ACTIVE)
  joiningDate             DateTime          @map("joining_date") @db.Timestamptz(6)
  lastLoginAt             DateTime?         @map("last_login_at") @db.Timestamptz(6)
  createdAt               DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt               DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt               DateTime?         @map("deleted_at") @db.Timestamptz(6)
  department              Department        @relation(fields: [departmentId], references: [id], onDelete: Restrict)
  manager                 User?             @relation("UserManager", fields: [managerId], references: [id], onDelete: SetNull)
  directReports           User[]            @relation("UserManager")
  profile                 EmployeeProfile?
  assignedCustomers       Customer[]
  assignedLeads           Lead[]
  leadActivities          LeadActivity[]
  createdProposals        Proposal[]
  createdProposalVersions ProposalVersion[]

  @@index([departmentId, status])
  @@index([managerId])
  @@index([joiningDate])
  @@index([status, deletedAt])
  @@map("users")
}

model EmployeeProfile {
  id           String   @id @default(uuid()) @db.Uuid
  userId       String   @unique @map("user_id") @db.Uuid
  jobTitle     String?  @map("job_title") @db.VarChar(120)
  workLocation String?  @map("work_location") @db.VarChar(120)
  bio          String?  @db.VarChar(1000)
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(6)
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@map("employee_profiles")
}

enum CustomerStatus {
  ACTIVE
  INACTIVE
  PROSPECT
  BLOCKED
}

enum CustomerContactStatus {
  ACTIVE
  INACTIVE
}

model Customer {
  id                    String            @id @default(uuid()) @db.Uuid
  customerCode          String            @unique @map("customer_code") @db.VarChar(32)
  companyName           String            @map("company_name") @db.VarChar(255)
  website               String?           @db.VarChar(2048)
  industry              String?           @db.VarChar(120)
  country               String?           @db.VarChar(100)
  state                 String?           @db.VarChar(100)
  city                  String?           @db.VarChar(100)
  address               String?           @db.Text
  source                String?           @db.VarChar(120)
  status                CustomerStatus    @default(PROSPECT)
  assignedSalespersonId String?           @map("assigned_salesperson_id") @db.Uuid
  createdAt             DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt             DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt             DateTime?         @map("deleted_at") @db.Timestamptz(6)
  assignedSalesperson   User?             @relation(fields: [assignedSalespersonId], references: [id], onDelete: SetNull)
  contacts              CustomerContact[]
  leads                 Lead[]
  proposals             Proposal[]

  @@index([companyName])
  @@index([status, deletedAt])
  @@index([assignedSalespersonId])
  @@map("customers")
}

model CustomerContact {
  id          String                @id @default(uuid()) @db.Uuid
  customerId  String                @map("customer_id") @db.Uuid
  firstName   String                @map("first_name") @db.VarChar(100)
  lastName    String?               @map("last_name") @db.VarChar(100)
  email       String?               @db.VarChar(320)
  phone       String?               @db.VarChar(32)
  designation String?               @db.VarChar(120)
  isPrimary   Boolean               @default(false) @map("is_primary")
  status      CustomerContactStatus @default(ACTIVE)
  createdAt   DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt   DateTime              @updatedAt @map("updated_at") @db.Timestamptz(6)
  customer    Customer              @relation(fields: [customerId], references: [id], onDelete: Cascade)

  // One-primary-contact uniqueness is enforced by a partial SQL index in the migration.
  @@index([customerId])
  @@index([email])
  @@index([phone])
  @@map("customer_contacts")
}

enum LeadStatus {
  NEW
  FOLLOW_UP
  MEETING
  PROPOSAL
  READY_TO_CLOSE
  WON
  LOST
}

enum LeadTemperature {
  COLD
  WARM
  HOT
}

enum LeadSource {
  WEBSITE
  REFERRAL
  SOCIAL_MEDIA
  ADVERTISEMENT
  COLD_CALL
  EMAIL
  DIRECT
  EXISTING_CUSTOMER
  OTHER
}

enum LeadActivityType {
  CALL
  EMAIL
  MEETING
  FOLLOW_UP
  PROPOSAL
  NOTE
  WHATSAPP
  OTHER
}

model Lead {
  id                String          @id @default(uuid()) @db.Uuid
  leadCode          String          @unique @map("lead_code") @db.VarChar(32)
  customerId        String?         @map("customer_id") @db.Uuid
  assignedToId      String          @map("assigned_to_id") @db.Uuid
  source            LeadSource
  contactName       String          @map("contact_name") @db.VarChar(200)
  email             String?         @db.VarChar(320)
  phone             String?         @db.VarChar(32)
  companyName       String?         @map("company_name") @db.VarChar(255)
  requirement       String?         @db.Text
  estimatedValue    Decimal?        @map("estimated_value") @db.Decimal(18, 2)
  expectedCloseDate DateTime?       @map("expected_close_date") @db.Timestamptz(6)
  status            LeadStatus      @default(NEW)
  temperature       LeadTemperature @default(COLD)
  notes             String?         @db.Text
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt         DateTime?       @map("deleted_at") @db.Timestamptz(6)
  customer          Customer?       @relation(fields: [customerId], references: [id], onDelete: SetNull)
  assignedTo        User            @relation(fields: [assignedToId], references: [id], onDelete: Restrict)
  activities        LeadActivity[]
  proposals         Proposal[]

  @@index([customerId])
  @@index([assignedToId, status, deletedAt])
  @@index([status, deletedAt])
  @@index([temperature, deletedAt])
  @@index([expectedCloseDate])
  @@index([createdAt])
  @@map("leads")
}

model LeadActivity {
  id             String           @id @default(uuid()) @db.Uuid
  leadId         String           @map("lead_id") @db.Uuid
  userId         String           @map("user_id") @db.Uuid
  activityType   LeadActivityType @map("activity_type")
  subject        String           @db.VarChar(255)
  description    String?          @db.Text
  scheduledAt    DateTime?        @map("scheduled_at") @db.Timestamptz(6)
  completedAt    DateTime?        @map("completed_at") @db.Timestamptz(6)
  nextFollowUpAt DateTime?        @map("next_follow_up_at") @db.Timestamptz(6)
  createdAt      DateTime         @default(now()) @map("created_at") @db.Timestamptz(6)
  lead           Lead             @relation(fields: [leadId], references: [id], onDelete: Restrict)
  user           User             @relation(fields: [userId], references: [id], onDelete: Restrict)

  @@index([leadId, createdAt])
  @@index([userId, nextFollowUpAt])
  @@index([activityType])
  @@index([scheduledAt])
  @@index([nextFollowUpAt])
  @@map("lead_activities")
}

enum ProposalStatus {
  DRAFT
  SENT
  UNDER_NEGOTIATION
  ACCEPTED
  REJECTED
  EXPIRED
  CANCELLED
}

enum ProposalVersionStatus {
  DRAFT
  ACTIVE
  SUPERSEDED
  ACCEPTED
  REJECTED
  CANCELLED
}

enum DiscountType {
  PERCENTAGE
  FIXED
}

model Proposal {
  id               String            @id @default(uuid()) @db.Uuid
  proposalCode     String            @unique @map("proposal_code") @db.VarChar(32)
  leadId           String?           @map("lead_id") @db.Uuid
  customerId       String            @map("customer_id") @db.Uuid
  createdById      String            @map("created_by_id") @db.Uuid
  title            String            @db.VarChar(255)
  status           ProposalStatus    @default(DRAFT)
  currentVersionId String?           @map("current_version_id") @db.Uuid
  validUntil       DateTime?         @map("valid_until") @db.Timestamptz(6)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(6)
  deletedAt        DateTime?         @map("deleted_at") @db.Timestamptz(6)
  lead             Lead?             @relation(fields: [leadId], references: [id], onDelete: SetNull)
  customer         Customer          @relation(fields: [customerId], references: [id], onDelete: Restrict)
  createdBy        User              @relation(fields: [createdById], references: [id], onDelete: Restrict)
  versions         ProposalVersion[] @relation("ProposalVersions")
  currentVersion   ProposalVersion?  @relation("ProposalCurrentVersion", fields: [id, currentVersionId], references: [proposalId, id], onDelete: Restrict, onUpdate: NoAction)

  @@index([leadId])
  @@index([customerId])
  @@index([createdById])
  @@index([status, deletedAt])
  @@index([validUntil])
  @@map("proposals")
}

model ProposalVersion {
  id              String                @id @default(uuid()) @db.Uuid
  proposalId      String                @map("proposal_id") @db.Uuid
  versionNumber   Int                   @map("version_number")
  status          ProposalVersionStatus @default(DRAFT)
  subtotal        Decimal               @db.Decimal(18, 2)
  discountAmount  Decimal               @map("discount_amount") @db.Decimal(18, 2)
  taxAmount       Decimal               @map("tax_amount") @db.Decimal(18, 2)
  totalAmount     Decimal               @map("total_amount") @db.Decimal(18, 2)
  notes           String?               @db.Text
  validUntil      DateTime?             @map("valid_until") @db.Timestamptz(6)
  createdById     String                @map("created_by_id") @db.Uuid
  createdAt       DateTime              @default(now()) @map("created_at") @db.Timestamptz(6)
  sentAt          DateTime?             @map("sent_at") @db.Timestamptz(6)
  acceptedAt      DateTime?             @map("accepted_at") @db.Timestamptz(6)
  rejectedAt      DateTime?             @map("rejected_at") @db.Timestamptz(6)
  rejectionReason String?               @map("rejection_reason") @db.Text
  proposal        Proposal              @relation("ProposalVersions", fields: [proposalId], references: [id], onDelete: Restrict)
  createdBy       User                  @relation(fields: [createdById], references: [id], onDelete: Restrict)
  items           ProposalItem[]
  currentFor      Proposal[]            @relation("ProposalCurrentVersion")

  @@unique([proposalId, versionNumber])
  // Required target key for the same-proposal current-version foreign key.
  @@unique([proposalId, id])
  @@index([createdById])
  @@index([status])
  @@index([createdAt])
  @@map("proposal_versions")
}

model ProposalItem {
  id                String          @id @default(uuid()) @db.Uuid
  proposalVersionId String          @map("proposal_version_id") @db.Uuid
  description       String          @db.Text
  quantity          Decimal         @default(1) @db.Decimal(18, 4)
  unitPrice         Decimal         @map("unit_price") @db.Decimal(18, 2)
  discountType      DiscountType?   @map("discount_type")
  discountValue     Decimal?        @map("discount_value") @db.Decimal(18, 2)
  amount            Decimal         @db.Decimal(18, 2)
  sortOrder         Int             @default(0) @map("sort_order")
  createdAt         DateTime        @default(now()) @map("created_at") @db.Timestamptz(6)
  updatedAt         DateTime        @updatedAt @map("updated_at") @db.Timestamptz(6)
  proposalVersion   ProposalVersion @relation(fields: [proposalVersionId], references: [id], onDelete: Restrict)

  @@index([proposalVersionId, sortOrder])
  @@map("proposal_items")
}
