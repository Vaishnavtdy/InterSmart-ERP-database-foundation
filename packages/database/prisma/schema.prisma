model ProjectBudget {
  id             String              @id @default(uuid()) @db.Uuid
  projectId      String              @unique @map("project_id") @db.Uuid
  totalBudget    Decimal             @map("total_budget") @db.Decimal(18, 2)
  currency       String              @default("INR") @db.VarChar(3)
  status         ProjectBudgetStatus @default(DRAFT)
  effectiveFrom  DateTime            @default(now()) @map("effective_from") @db.Timestamptz(6)
  effectiveUntil DateTime?           @map("effective_until") @db.Timestamptz(6)
  notes          String?             @db.Text
